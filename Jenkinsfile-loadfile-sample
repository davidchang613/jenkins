def map = [:]
def modules = [:]

pipeline {
  agent any

  stages {
    stage('load file') {
      steps {
        script {
          modules.shared = load "./lib/shared.groovy"
          modules.shared.getSelf()

          echo 'reading config/config.data'
          modules.shared.readVariablesFromFile("./config/config.data", map)
          echo 'line1='
          echo map['line1']
        }
      }
    }
  }
}